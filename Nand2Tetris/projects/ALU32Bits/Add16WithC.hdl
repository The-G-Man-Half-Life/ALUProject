CHIP Add16WithC {
    IN a[16], b[16], cin;
    OUT out[16], cout;

    PARTS:
    FullAdder(a=a[0], b=b[0], c=cin, sum=out[0], carry=c0);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el primer bit | Notese que el cin es el carry de entrada, así, para la suma de los primeros 16 bits, el carry inicial es false, y para la suma de los 16 restantes, el valor pasado depende del carry del fulladder para el bit en el bus 15.  
    FullAdder(a=a[1], b=b[1], c=c0, sum=out[1], carry=c1);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el segundo bit
    FullAdder(a=a[2], b=b[2], c=c1, sum=out[2], carry=c2);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el tercer bit
    FullAdder(a=a[3], b=b[3], c=c2, sum=out[3], carry=c3);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el cuarto bit
    FullAdder(a=a[4], b=b[4], c=c3, sum=out[4], carry=c4);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el quinto bit
    FullAdder(a=a[5], b=b[5], c=c4, sum=out[5], carry=c5);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el sexto bit
    FullAdder(a=a[6], b=b[6], c=c5, sum=out[6], carry=c6);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el septimo bit
    FullAdder(a=a[7], b=b[7], c=c6, sum=out[7], carry=c7);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el octavo bit
    FullAdder(a=a[8], b=b[8], c=c7, sum=out[8], carry=c8);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el noveno bit
    FullAdder(a=a[9], b=b[9], c=c8, sum=out[9], carry=c9);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el decimo bit
    FullAdder(a=a[10], b=b[10], c=c9, sum=out[10], carry=c10);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el decimo primer bit
    FullAdder(a=a[11], b=b[11], c=c10, sum=out[11], carry=c11);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el decimo segundo bit
    FullAdder(a=a[12], b=b[12], c=c11, sum=out[12], carry=c12);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el decimo tercer bit
    FullAdder(a=a[13], b=b[13], c=c12, sum=out[13], carry=c13);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el decimo cuarto bit
    FullAdder(a=a[14], b=b[14], c=c13, sum=out[14], carry=c14);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el decimo quinto bit
    FullAdder(a=a[15], b=b[15], c=c14, sum=out[15], carry=cout);  // Aqui sacamos el carry de la suma de a y b | Ejemplo : 1 + 1 = 10, el carry es 1 y la suma es 0 | Como hay un carry de entrada, usamos un FullAdder para el decimo sexto bit | Este carry es el carry que se pasa a la siguiente suma de 16 bits
}
